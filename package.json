{
  "name": "converta",
  "productName": "Converta",
  "version": "1.0.0",
  "description": "Converta arquivos para outro formato direto no seu dispositivo: imagens, PDF, vídeo, áudio, documentos e planilhas.",
  "author": "Converta",
  "license": "GPL-3.0-or-later",
  "homepage": "https://matheulb.github.io/Conversor-de-arquivos/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatheuLB/Conversor-de-arquivos.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "converta.desktop",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && vite",
    "build": "node scripts/copy-assets.mjs && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win && node scripts/portable-zip.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "heic2any": "^0.0.4",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "^9.3.12",
    "turndown": "^7.2.4",
    "utif2": "^4.1.0",
    "vite": "^8.3.5",
    "write-excel-file": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "io.github.converta",
    "productName": "Converta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Converta-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Converta-Setup.${ext}",
      "shortcutName": "Converta"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Converta-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Converta-linux.${ext}",
      "syncDesktopName": true
    },
    "publish": null
  }
}
